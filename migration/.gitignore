node_modules/
.cache/
# Bare mirror clones of the source repos: large, regenerable (git clone --mirror),
# and migration-owned — never committed. The lockfile is the record of their pins.
.sources/
# manifest.json + lockfile.json under build/ are committed on purpose (evidence chain);
# everything else generated stays out.
# Top-level generated reports + logs (timestamped/regenerable: constructcheck-report,
# refcheck-report, index-pass.log). The committed manifest/lockfile live one level
# down (build/manifest/, build/smoke/) so this root-only glob leaves them tracked.
build/*.json
build/*.log
build/golden/
build/golden-smoke/
# Census render: the throwaway poisoned render the no-baking gate reads its
# expectations from (npm run census). Regenerable, and never a golden.
build/census/
build/diff/
build/partials-report-*.json
# Converter/marker validation scratch (regenerable; never committed).
build/_p*/
