{
  "name": "hazelcast-docs-migration",
  "version": "0.0.0",
  "private": true,
  "description": "Disposable migration tooling for the Antora -> Docusaurus migration. Walled off from the Docusaurus site at the repo root; has its own Antora/asciidoctor deps so they never pollute the site build. Removed (git rm -r migration/) once the migration is complete.",
  "license": "UNLICENSED",
  "scripts": {
    "index-pass": "node index-pass.js antora/index-playbook.yml",
    "fidelity:snapshot": "node fidelity/build-snapshot.js antora/index-playbook.yml",
    "census": "node fidelity/build-snapshot.js antora/index-playbook.yml --census",

    "check": "node check.js",
    "check:fidelity": "node fidelity/run.js",
    "check:refs": "node refcheck/run.js",
    "check:constructs": "node constructcheck/run.js",
    "check:orphans": "node orphancheck/run.js",

    "selftest": "node selftest.js",
    "selftest:layout": "node lib/selftest.js",
    "selftest:image-placement": "node lib/image-placement-selftest.js",
    "selftest:slice-region": "node lib/slice-region-selftest.js",
    "selftest:image-alt": "node lib/image-alt-unescape-selftest.js",
    "selftest:accepted": "node lib/accepted-selftest.js",
    "selftest:dispositions": "node lib/dispositions-selftest.js",
    "selftest:live-set": "node lib/live-set-selftest.js",
    "selftest:converter": "node converter/selftest.js",
    "check:fidelity:selftest": "node fidelity/selftest.js",
    "check:refs:selftest": "node refcheck/selftest.js",
    "check:constructs:selftest": "node constructcheck/selftest.js",
    "check:orphans:selftest": "node orphancheck/selftest.js",

    "diagnose:layer3": "node fidelity/layer3-report.js"
  },
  "dependencies": {
    "@antora/asciidoc-loader": "3.1.14",
    "@antora/content-aggregator": "3.1.14",
    "@antora/content-classifier": "3.1.14",
    "@antora/logger": "3.1.14",
    "@antora/playbook-builder": "3.1.14",
    "cheerio": "^1.2.0",
    "github-slugger": "^1.5.0",
    "hazelcast-docs-tools": "github:hazelcast/hazelcast-docs-tools#semver:2.5.0",
    "js-yaml": "^4.3.2"
  }
}
