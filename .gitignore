# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Per-release sidebar stubs: identical, information-free boilerplate that
# src/docsPlugins.ts writes from <id>_versions.json when the config is evaluated
# and deletes again when the process exits, so it exists only while a build or
# dev server needs it. To keep a hand-tuned sidebar for one release, un-ignore
# that file and commit it — anything that isn't our stub is left untouched.
/*_versioned_sidebars/

# OpenAPI specs staged by plugins/openapi-specs. Fetched from the product repo
# that owns them on every build and served from here as static attachments, so
# the site can publish a spec that lives in a private repo. Never committed:
# the product repo is the source of truth and there is no copy here to drift.
/.api-specs/

# Local editor/agent settings (Claude Code launch config, permissions): per-
# machine, not part of the site.
/.claude/

# Maven output from the Java example compile gate (pom.xml).
/target/

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tutorial-examples/

# Local Netlify folder
.netlify

# Vale: packages installed by `vale sync`; only the house style and vocabulary are ours.
/.vale/*
!/.vale/Hazelcast/
!/.vale/config/
