# Per-release sidebar stubs: identical, information-free boilerplate that
# src/docsPlugins.ts regenerates from <id>_versions.json at config-eval time.
# To keep a hand-tuned sidebar for one release, un-ignore that file and commit
# it — the generator never overwrites an existing stub.
/*_versioned_sidebars/

